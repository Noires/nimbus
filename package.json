{
  "name": "nimbus",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "server"],
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "docker:up": "docker compose up -d",
    "docker:smoke": "./scripts/compose-smoke.sh",
    "test": "env -u NIMBUS_TEST_BASE_URL node --test test/*.test.mjs",
    "test:integration": "node --test test/blocker-links.integration.test.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep axe",
    "migrate": "cd server && npx prisma migrate dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.12.1"
  }
}
